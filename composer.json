{
    "name": "namingo/plexdns",
    "description": "Cardo DNS - a unified, multi-provider DNS management library",
    "homepage": "https://github.com/getnamingo/cardo-dns",
    "license": "MIT",
    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3.0",
        "ext-pdo": "*",
        "guzzlehttp/guzzle": "^7.15.2",
        "vultr/vultr-php": "^1.0",
        "badcow/dns": "^4.3",
        "exonet/powerdns-php": "^4.7.1",
        "dnsimple/dnsimple": "^1.4",
        "spatie/dns": "^2.6",
        "monolog/monolog": "^3.9",
        "vlucas/phpdotenv": "^5.6",
        "cloudflare/sdk": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "autoload": {
        "psr-4": {
            "Namingo\\Cardo\\DNS\\": "src/"
        },
        "files": [
            "src/compat.php",
            "src/Helpers.php"
        ]
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "analyze": "phpstan analyse src --level=0 --memory-limit=512M",
        "test": [
            "php tests/CompatibilityTest.php",
            "php tests/TestingProviderTest.php",
            "php tests/ServiceStateTest.php",
            "php tests/BindServiceTest.php",
            "php tests/HetznerProviderTest.php",
            "php tests/HetznerServiceTest.php",
            "php tests/DigitalOceanProviderTest.php",
            "php tests/DigitalOceanServiceTest.php",
            "php tests/GandiLiveDNSProviderTest.php",
            "php tests/GandiLiveDNSServiceTest.php",
            "php tests/ImportantRecordTypesTest.php",
            "php tests/PowerDNSServiceTest.php",
            "php tests/ScalewayProviderTest.php",
            "php tests/ScalewayServiceTest.php",
            "php tests/ProviderDnssecTest.php",
            "@analyze"
        ]
    }
}
